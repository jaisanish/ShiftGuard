# ShiftGuard Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./shiftguard.db
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
SERVICE_NAME=shiftguard-edge
ENVIRONMENT=development
LOG_LEVEL=INFO
CLOUD_ENABLED=true
CLOUD_DATABASE_URL=sqlite:///./shiftguard_cloud.db
CLOUD_SYNC_URL=http://127.0.0.1:8000/api/sync/events
# Keep local for offline demo; set COPILOT_PROVIDER=openai and OPENAI_API_KEY in deployment if needed.
COPILOT_PROVIDER=local
OPENAI_MODEL=gpt-4.1-mini
