# ShiftGuard Configuration Template
# =================================

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=shiftguard-edge

# Edge Database (SQLite)
DATABASE_URL=sqlite:///./shiftguard.db
EDGE_DATABASE_URL=sqlite:///./shiftguard.db

# Cloud Database (PostgreSQL in production; SQLite fallback for zero-setup demo)
# Production PostgreSQL example:
# CLOUD_DATABASE_URL=postgresql+psycopg2://shiftguard_user:password@localhost:5432/shiftguard_cloud
CLOUD_DATABASE_URL=sqlite:///./shiftguard_cloud.db

# Cloud Synchronization Worker
CLOUD_SYNC_URL=http://127.0.0.1:8000/api/sync/events
SYNC_BATCH_SIZE=25
SYNC_INTERVAL_SECONDS=3.0
SYNC_RETRY_LIMIT=5
SYNC_BACKOFF_BASE=2.0
CLOUD_ENABLED=true

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]
